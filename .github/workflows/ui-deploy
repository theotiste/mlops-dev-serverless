name: ui-deploy

on:
  push:
    branches: [ main ]
    paths:
      - 'ui/**'           # ne déclenche que si le dossier ui change
      - '.github/workflows/ui-deploy.yml'

jobs:
  deploy-ui:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Trigger Amplify via Webhook
        if: ${{ secrets.AMPLIFY_WEBHOOK_URL != '' }}
        run: |
          curl -s -X POST \
            -H "Content-Type: application/json" \
            -d '{"trigger":"github-actions"}' \
            "${{ secrets.AMPLIFY_WEBHOOK_URL }}"
